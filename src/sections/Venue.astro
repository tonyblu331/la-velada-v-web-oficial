---
import SectionHeader from '@/components/SectionHeader.astro'

const VENUE_QUERY = encodeURIComponent('Estadio de La Cartuja, Sevilla')
const GMAPS_EMBED = `https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1580!2d-5.97617!3d37.40942!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xd12626e8c7c9c7d%3A0x8c9c9c9c9c9c9c9c!2sEstadio%20de%20La%20Cartuja!5e0!3m2!1ses!2ses!4v1`
---

<section id="venue" class="relative w-full px-4 pb-20 sm:px-6 lg:pb-28" aria-labelledby="venue-title">
  <div class="mx-auto flex max-w-7xl flex-col items-center">
    <SectionHeader
      titleId="venue-title"
      title="DÓNDE ES"
      subtitle="Estadio de La Cartuja, Sevilla — 25 de julio de 2026"
    />

    <div class="relative w-full overflow-hidden rounded-2xl border border-white/10 bg-theme-navy/30 shadow-[0_25px_60px_-30px_rgba(0,0,0,0.8)]">
      <iframe
        title="Mapa del Estadio de La Cartuja"
        src={GMAPS_EMBED}
        width="100%"
        height="400"
        style="border:0; display: block;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href={`https://www.google.com/maps/search/?api=1&query=${VENUE_QUERY}`}
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-2.5 font-cinzel text-[0.65rem] font-bold tracking-[0.25em] text-white/80 transition hover:border-theme-gold/60 hover:text-theme-gold focus-visible:border-theme-gold/70 focus-visible:text-theme-gold"
      >
        Google Maps
      </a>
      <a
        href={`http://maps.apple.com/?q=${VENUE_QUERY}`}
        target="_blank" rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-2.5 font-cinzel text-[0.65rem] font-bold tracking-[0.25em] text-white/80 transition hover:border-theme-gold/60 hover:text-theme-gold focus-visible:border-theme-gold/70 focus-visible:text-theme-gold"
      >
        Apple Maps
      </a>
    </div>
  </div>
</section>
